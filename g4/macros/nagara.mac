# Xi- + 12C -> LL6He + 4He + t (Nagara-like topology)
#   LL6He -> L5He + p + pi-, L5He -> 4He + p + pi- with the simple policy
/control/verbose 1
/run/verbose 1

/emul/density 3.53
/emul/halfSize 20 mm
/emul/minStep 0.1 um
/emul/maxStep 10 um
/emul/rangeFraction 0.01
/run/initialize

/xi/speciesFile ../../output/species.csv
/xi/targetsFile ../../output/targets.csv
/xi/decaysFile ../../output/decays.csv
/xi/target 12C
/xi/channel LL6He,4He,t
/xi/seed 1

# simple, uniform or uniformPiMinus; /decay/channel fixes one parent
/decay/policy simple
/decay/channel LL6He L5He,p,pi-

/out/file nagara.root
/run/beamOn 100
